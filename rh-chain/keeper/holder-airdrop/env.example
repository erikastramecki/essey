# Holder-airdrop keeper. Copy to .env and fill in. Never commit a filled copy — KEEPER_PRIVKEY is a key.

RH_RPC=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# VERIFIED on chain 2026-09-02: symbol ESSEY, decimals 18, totalSupply 8888888888000000000000000000,
# and its ONLY Transfer ever is the genesis mint at block 49634440 to 0x93e6e42CcC676614FB3635b0983d60F35dDE4B9E.
ESSEY_TOKEN=0x315790B57C19141B34C4653a91b096Cf3f071610
ESSEY_TOKEN_FIRST_BLOCK=49634440

# NOT DEPLOYED YET — fill in at deploy time. Never guess these.
HOLDER_DISTRIBUTOR=
BASKET_REGISTRY=
USDG=

# Eligibility bar — the founder-locked 0.1% of supply. 10 bps of totalSupply = 8,888,888.888 $ESSEY.
# Set HOLDER_BAR_WEI to pin an exact figure instead (it wins over the bps form). Inclusive at the bar.
HOLDER_BAR_BPS=10
# HOLDER_BAR_WEI=8888889000000000000000000

# LOAD-BEARING: any wallet left out of this list takes its pro-rata share of every epoch. The treasury /
# ops wallet, the AMM pool, LP positions, the reserve and the distributor itself all belong here, or the
# airdrop pays itself. Comma-separated. FOUNDER MUST RULE the final set before the first root.
EXCLUSIONS=0x93e6e42CcC676614FB3635b0983d60F35dDE4B9E

EPOCH_SECONDS=43200
SNAPSHOT_CONFIRMATIONS=30
MIN_POT_USDG=1000000
DEFAULT_BASKET_ID=0
STATE_DIR=./keeper-state
# PREFERENCES_FILE=./preferences.json

# Nothing is sent unless BOTH of these are set. Leave EXECUTE unset to plan and print only.
# EXECUTE=1
# KEEPER_PRIVKEY=
