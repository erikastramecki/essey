<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The PAGER, and the second half of what xyz.essey.liveness-keeper.plist only looks like it does.
     G-LEND R8 LOW-1: check-liveness-keeper.mjs was the only thing that evaluates the UNOBSERVED
     condition and NOTHING in the repo ran it, so the stated "12h to detect" was 9h to the condition
     plus however often a human typed the command. KeepAlive on the keeper unit restarts a CRASHED
     keeper; it cannot see a keeper that is up and observing nothing, which is R4 HIGH-2 exactly.

     This is an INTERVAL job, not a daemon: StartInterval, no KeepAlive. page-liveness-keeper.sh is
     what turns the exit code into a notification, because launchd cannot.

     Install (mainnet operator box):
       sed "s|__REPO__|$(git rev-parse --show-toplevel)|g" keeper/xyz.essey.liveness-pager.plist \
         > ~/Library/LaunchAgents/xyz.essey.liveness-pager.plist
       launchctl load -w ~/Library/LaunchAgents/xyz.essey.liveness-pager.plist
     __REPO__ is a placeholder, not a path: launchd does not expand variables, and an absolute home
     path here leaks the machine's layout into a public repo (the pre-commit gate blocks it).

     LIVENESS_ORACLE / ESSEY_MARKETS / MARKET_TOKENS / PAGER_WEBHOOK_URL live in .env.liveness-pager
     at the repo root (gitignored), which the wrapper sources. Never here. The check needs no key —
     it is read-only — so this unit holds no secret at all.
     On Linux use the same wrapper under a systemd .timer with OnUnitActiveSec=15min. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>xyz.essey.liveness-pager</string>

  <key>WorkingDirectory</key>
  <string>__REPO__/rh-chain</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/rh-chain/keeper/page-liveness-keeper.sh</string>
  </array>

  <!-- launchd starts with a minimal PATH and neither node nor curl is on it; without this the unit
       flaps and the PAGER looks configured while never running, which is the failure it exists to
       catch wearing a different hat (the game-keeper plist's lesson). -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- 900s. The alarm CONDITION goes fatal 9h after the keeper stops observing (MAX_CONFIRM_AGE),
       so a 15-minute poll makes delivered detection ~9.25h — far inside the 48h keeper gap the
       PRICE_CONFIRM_DELAY derivation is now quoted at, with the margin to spare that the 12h SLO
       only claimed. Each run is a handful of eth_calls; do not lower it into rate-limit territory. -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__REPO__/rh-chain/.keeper-state/liveness-pager.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/rh-chain/.keeper-state/liveness-pager.err</string>
</dict>
</plist>
