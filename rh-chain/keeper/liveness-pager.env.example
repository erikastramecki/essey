# Copy to <repo root>/.env.liveness-pager (gitignored by `.env.*`) and fill in.
# page-liveness-keeper.sh sources this; override the location with LIVENESS_PAGER_ENV.
# The check is READ-ONLY — no private key belongs in here, ever.

LIVENESS_ORACLE=0x
ESSEY_MARKETS=0x

# REQUIRED, and the check's independent source of truth for the market set (G-LEND R5 MED-2).
# Add a market here in the same change that commits it.
MARKET_TOKENS=0x,0x

RH_RPC=https://rpc.mainnet.chain.robinhood.com

# The page itself. Leave this unset and the unit is NOT a pager: every failing run prints
# NO PAGE SENT and the alert reaches only .keeper-state/liveness-pager.alert and the log.
PAGER_WEBHOOK_URL=

# Optional: block to scan MarketCommitted from, and a per-market override for MAX_DARK_AGE.
# MARKETS_FROM_BLOCK=0
# FEED_DARK_CEILING=345600
