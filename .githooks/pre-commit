#!/bin/sh
# Pre-commit secret + private-path gate for a PUBLIC repo.
#
# Why this exists: on 2026-09-02 an audit found two other private repo names
# (another private repo, and the ceremony checkout) committed inside absolute paths in a test
# harness. Memory claimed a hook protected this repo. There was none — the hooks
# directory held only samples. History had to be rewritten to remove them.
#
# Exit 1 blocks the commit. Escape hatch: COMMIT_SECRET_OK=1, deliberate only.

[ "$COMMIT_SECRET_OK" = "1" ] && exit 0

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0
say() { printf '%s\n' "$*" >&2; fail=1; }

# 1. Files that must never be committed at all.
for f in $staged; do
  # A .example/.sample is a TEMPLATE and is meant to be committed, so the FILENAME rule skips it —
  # a gate that cries wolf is a gate people learn to bypass. But exempting it removed cover the content
  # scan never had: OPERATOR_PK=, DEPLOYER_KEY= and a real webhook URL all passed, because the content
  # patterns look for the literal words private_key/mnemonic. This repo's own memory note reads "public
  # repo with a live operator key" — OPERATOR_PK is exactly the name that slips.
  #
  # So a template is checked by what a template IS, not by guessing secret shapes: every NAME=VALUE must
  # be EMPTY or an obvious placeholder. That needs no list of key names and fails closed on shapes nobody
  # has thought of yet. Verified adversarially (OPERATOR_PK, DEPLOYER_KEY, a webhook, an RPC with a key),
  # not by re-planting the PRIVATE_KEY the scan already caught — which is what the first version did.
  case "$f" in
    *.example|*.sample|*.template)
      _filled=$(
        git cat-file blob ":$f" 2>/dev/null | grep -nE '^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=' \
          | grep -vE '=[[:space:]]*("")?$|=[[:space:]]*0x[[:space:]]*$|=[[:space:]]*(<|\{\{|\$\{|CHANGE|REPLACE|YOUR|TODO|FIXME|xxx|XXX|\.\.\.|__)'
      )
      # NB: assign in the PARENT. Piping into `while ... say` put the flag in a subshell, so the gate
      # printed BLOCKED and still exited 0 — reporting without enforcing, which is the defect this
      # file exists to catch. Verified by exit code, not by the message.
      if [ -n "$_filled" ]; then
        say "BLOCKED: $f — a template must hold placeholders, not values:"
        printf '%s\n' "$_filled" | sed 's/^/    /' >&2
      fi
      continue ;;
  esac
  case "$f" in
    *.env|*.env.*|.env|.env.*|*.pem|*.key|*.keypair.json|*.keystore)
      say "BLOCKED: $f — secrets file staged." ;;
  esac
done

# 2. Content patterns, checked on the staged blob (not the worktree).
for f in $staged; do
  git cat-file -e ":$f" 2>/dev/null || continue
  case "$f" in *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.pdf|*.zkey|*.ptau|*.wasm|*.woff*) continue ;; esac
  blob=$(git cat-file blob ":$f" 2>/dev/null) || continue

  printf '%s' "$blob" | grep -qE 'BEGIN [A-Z ]*PRIVATE KEY' \
    && say "BLOCKED: $f — PEM private key."

  # A bare 64-hex assignment reads as a raw private key. Bytes32 literals in
  # source are the common false positive, so only flag it next to a key-ish name.
  printf '%s' "$blob" | grep -qiE '(private_?key|secret_?key|mnemonic|seed_?phrase)[^=:]{0,20}[=:]\s*["'\'']?(0x)?[0-9a-fA-F]{64}' \
    && say "BLOCKED: $f — hardcoded private key or mnemonic."

  # The actual 2026-09-02 leak: an absolute home path naming another repo.
  printf '%s' "$blob" | grep -qE '/Users/[A-Za-z0-9._-]+/(Developer|Documents|Desktop)/' \
    && say "BLOCKED: $f — absolute home path. It leaks your directory layout (and other repo names). Use an env var with a relative default."

  printf '%s' "$blob" | grep -qiE '(api[_-]?key|auth[_-]?token|bearer)[^=:]{0,12}[=:]\s*["'\''][A-Za-z0-9_\-]{20,}' \
    && say "BLOCKED: $f — API key or token literal."
done

if [ "$fail" -ne 0 ]; then
  printf '%s\n' "" \
    "This repo is PUBLIC. Fix the lines above, or re-run with COMMIT_SECRET_OK=1" \
    "if you have genuinely verified it is safe to publish." >&2
  exit 1
fi
exit 0
