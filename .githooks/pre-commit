#!/bin/sh
# Pre-commit secret + private-path gate for a PUBLIC repo.
#
# Why this exists: on 2026-09-02 an audit found two other private repo names
# ("[redacted]", the ceremony checkout) committed inside absolute paths in a test
# harness. Memory claimed a hook protected this repo. There was none — the hooks
# directory held only samples. History had to be rewritten to remove them.
#
# Exit 1 blocks the commit. Escape hatch: COMMIT_SECRET_OK=1, deliberate only.

[ "$COMMIT_SECRET_OK" = "1" ] && exit 0

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0
say() { printf '%s\n' "$*" >&2; fail=1; }

# 1. Files that must never be committed at all.
for f in $staged; do
  case "$f" in
    *.env|*.env.*|.env|.env.*|*.pem|*.key|*.keypair.json|*.keystore)
      say "BLOCKED: $f — secrets file staged." ;;
  esac
done

# 2. Content patterns, checked on the staged blob (not the worktree).
for f in $staged; do
  git cat-file -e ":$f" 2>/dev/null || continue
  case "$f" in *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.pdf|*.zkey|*.ptau|*.wasm|*.woff*) continue ;; esac
  blob=$(git cat-file blob ":$f" 2>/dev/null) || continue

  printf '%s' "$blob" | grep -qE 'BEGIN [A-Z ]*PRIVATE KEY' \
    && say "BLOCKED: $f — PEM private key."

  # A bare 64-hex assignment reads as a raw private key. Bytes32 literals in
  # source are the common false positive, so only flag it next to a key-ish name.
  printf '%s' "$blob" | grep -qiE '(private_?key|secret_?key|mnemonic|seed_?phrase)[^=:]{0,20}[=:]\s*["'\'']?(0x)?[0-9a-fA-F]{64}' \
    && say "BLOCKED: $f — hardcoded private key or mnemonic."

  # The actual 2026-09-02 leak: an absolute home path naming another repo.
  printf '%s' "$blob" | grep -qE '/Users/[A-Za-z0-9._-]+/(Developer|Documents|Desktop)/' \
    && say "BLOCKED: $f — absolute home path. It leaks your directory layout (and other repo names). Use an env var with a relative default."

  printf '%s' "$blob" | grep -qiE '(api[_-]?key|auth[_-]?token|bearer)[^=:]{0,12}[=:]\s*["'\''][A-Za-z0-9_\-]{20,}' \
    && say "BLOCKED: $f — API key or token literal."
done

if [ "$fail" -ne 0 ]; then
  printf '%s\n' "" \
    "This repo is PUBLIC. Fix the lines above, or re-run with COMMIT_SECRET_OK=1" \
    "if you have genuinely verified it is safe to publish." >&2
  exit 1
fi
exit 0
